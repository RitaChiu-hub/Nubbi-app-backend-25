# Database Connection (Local)
DATABASE_NAME=nuubi_local
DATABASE_HOST=localhost
DATABASE_PASSWORD=your_password
DATABASE_USER=your_user
DATABASE_PORT=5432

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=''

# AWS S3 & SQS Configuration (REPLACE WITH YOUR OWN)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/your-queue-name
AWS_SQS_KNOWLEDGE_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/your-knowledge-queue-name

# Authentication
JWT_SECRET=your_jwt_secret

# Other Services
CLOUDINARY_SECRET=your_cloudinary_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
STRIPE_SECRET_KEY=your_stripe_key

# AI Services
LLAMA_API_URL=https://router.huggingface.co/v1
LLAMA_API_KEY=your_llama_key
OPENAI_API_KEY=your_openai_key
OPENAI_ORG_ID=your_openai_org_id
